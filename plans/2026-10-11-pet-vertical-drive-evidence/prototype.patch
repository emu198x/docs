+    #[test]
+    fn vertical_drive_reaches_via_and_pia_with_the_same_polarity() {
+        for columns in [40, 80] {
+            for rising_edge in [false, true] {
+                let mut kernal = vec![0xEA; 0x1000];
+                kernal[..4].copy_from_slice(&[0x78, 0x4C, 0x01, 0xF0]);
+                kernal[0xFFC..0xFFE].copy_from_slice(&0xF000u16.to_le_bytes());
+                let mut pet = Pet::new(
+                    kernal,
+                    vec![0; 0x2000],
+                    vec![0; 0x800],
+                    vec![0; 0x1000],
+                    columns,
+                );
+                pet.run_frame();
+                pet.mem_write(0xE813, 0x04 | if rising_edge { 0x02 } else { 0 });
+                pet.mem_read(0xE812);
+
+                let mut previous = !pet.crtc.vsync;
+                let mut low_samples = 0;
+                let mut high_samples = 0;
+                let mut detected_edges = 0;
+                for _ in 0..50_000 {
+                    pet.tick();
+                    // Commodore 8032029/8032081 sheets 3, 8 and 10:
+                    // the pull-up-selected XOR drives both pins with !VSYNC.
+                    let drive = !pet.crtc.vsync;
+                    assert_eq!(
+                        pet.mem_read(0xE840) & 0x20 != 0,
+                        drive,
+                        "VIA PB5: {columns} columns, clock {}",
+                        pet.master_clock,
+                    );
+                    let edge = if rising_edge {
+                        !previous && drive
+                    } else {
+                        previous && !drive
+                    };
+                    assert_eq!(
+                        pet.mem_read(0xE813) & 0x80 != 0,
+                        edge,
+                        "PIA CB1: {columns} columns, rising={rising_edge}, clock {}",
+                        pet.master_clock,
+                    );
+                    pet.mem_read(0xE812);
+                    low_samples += usize::from(!drive);
+                    high_samples += usize::from(drive);
+                    detected_edges += usize::from(edge);
+                    previous = drive;
+                }
+                assert!(low_samples > 0 && high_samples > 0);
+                assert!(detected_edges >= 2);
+
+                // An output-configured PB5 still reads its output latch.
+                pet.mem_write(0xE842, 0x20);
+                for output in [0, 0x20] {
+                    pet.mem_write(0xE840, output);
+                    assert_eq!(pet.mem_read(0xE840) & 0x20, output);
+                }
+            }
+        }
+    }
+
     /// VIA register addresses on the PET's $E840 block.
     const VIA_SR: u16 = 0xE84A;
     const VIA_ACR: u16 = 0xE84B;
